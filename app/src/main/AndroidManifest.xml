<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Phase 4: REST calls to Drive (googleapis.com) for cloud backup.
         Phase 6, Stage 2 (backlog): same permission, reused for REST calls to TheGamesDB. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".ThePatientGamerHelperApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.ThePatientGamerHelper">

        <!--
          ThePatientGamerHelperApplication implements Configuration.Provider (Phase 4, to inject
          HiltWorkerFactory): WorkManager's default initialization must be explicitly removed,
          otherwise it would conflict with the custom one lazily initialized on the first
          WorkManager.getInstance(context) call — see the RemoveWorkManagerInitializer lint check.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="remove" />

        <!--
          Phase 5: automatic persistence of the per-app language chosen with
          AppCompatDelegate.setApplicationLocales() — without this service/meta-data
          (autoStoreLocales) the preference would have to be saved by hand.
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ThePatientGamerHelper">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
