<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Fase 4: chiamate REST a Drive (googleapis.com) per il backup cloud.
         Tappa 2 (backlog): stesso permesso, riusato per le chiamate REST a TheGamesDB. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".ThePatientGamerHelperApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.ThePatientGamerHelper">

        <!--
          ThePatientGamerHelperApplication implementa Configuration.Provider (Fase 4, per iniettare
          HiltWorkerFactory): l'inizializzazione di default di WorkManager va rimossa esplicitamente,
          altrimenti entrerebbe in conflitto con quella custom lazy-inizializzata al primo
          WorkManager.getInstance(context) — vedi lint RemoveWorkManagerInitializer.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="remove" />

        <!--
          Fase 5: persistenza automatica della lingua per-app scelta con
          AppCompatDelegate.setApplicationLocales() — senza questo service/meta-data
          (autoStoreLocales) la preferenza andrebbe salvata a mano.
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ThePatientGamerHelper">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
